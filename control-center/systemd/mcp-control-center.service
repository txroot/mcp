[Unit]
Description=MCP Control Center
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mcp-control-center
ExecStart=/usr/bin/python3 %h/.local/share/mcp-control-center/server.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
